{
  "manifest_version": 3,
  "name": "Sayvia subtitle research probe",
  "version": "0.0.1",
  "description": "Local diagnostic prototype: observes normal YouTube subtitle responses; no model calls.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["panel.js"],
      "run_at": "document_start"
    }
  ]
}
